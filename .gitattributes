###############################################################################
# Configuración de atributos Git + Git LFS — JESUSCASTRODATA
# Proyecto: Delitos e Inmigración en España (2010–2023)
# Propósito: asegurar texto normalizado y manejar binarios pesados vía LFS
###############################################################################

# ── Normalización segura de fin de línea (LF universal)
* text=auto eol=lf

# ── Tratar como texto (mejores diffs/merges en Git)
*.R        text
*.Rmd      text
*.qmd      text
*.md       text
*.csv      text
*.tsv      text
*.json     text
*.yaml     text
*.yml      text
*.txt      text
Makefile   text

# ─────────────────────────────────────────────────────────────
# GIT LFS — binarios y artefactos grandes
# ─────────────────────────────────────────────────────────────

# Figuras y modelos (salidas grandes)
output/figures/**   filter=lfs diff=lfs merge=lfs -text
output/models/**    filter=lfs diff=lfs merge=lfs -text

# PDFs compilados y entregas
docs/*.pdf          filter=lfs diff=lfs merge=lfs -text
output/release/**   filter=lfs diff=lfs merge=lfs -text

# Archivos binarios de oficina (opcionales)
output/tables/*.xlsx  filter=lfs diff=lfs merge=lfs -text
docs/*.pptx           filter=lfs diff=lfs merge=lfs -text

# Archivos binarios R (opcional: descomenta si los usas)
# data/processed/*.rds      filter=lfs diff=lfs merge=lfs -text
# data/processed/*.parquet  filter=lfs diff=lfs merge=lfs -text

# CSV grandes (opcional: solo si pesan >50 MB)
# output/tables/*.csv       filter=lfs diff=lfs merge=lfs -text

