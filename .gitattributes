
# ── Texto: normaliza fin de línea a LF (seguro entre Windows/Linux)
* text=auto eol=lf
# ── Tratar como texto (mejores diffs/merges)
*.R   text
*.Rmd text
*.qmd text
*.md  text
*.csv text
*.yml text
*.yaml text
*.json text
*.tsv text
*.txt text
Makefile text
# ── Git LFS (binarios pesados)
# Figuras y artefactos de modelos → LFS
output/figures/** filter=lfs diff=lfs merge=lfs -text
output/models/**  filter=lfs diff=lfs merge=lfs -text
# PDFs compilados → LFS (incluye carpeta release)
docs/*.pdf        filter=lfs diff=lfs merge=lfs -text
output/release/** filter=lfs diff=lfs merge=lfs -text
# (Opcional) Excel y presentaciones → LFS
output/tables/*.xlsx filter=lfs diff=lfs merge=lfs -text
docs/*.pptx          filter=lfs diff=lfs merge=lfs -text
# (Opcional) Binarios R → LFS
# data/processed/*.rds      filter=lfs diff=lfs merge=lfs -text
# data/processed/*.parquet  filter=lfs diff=lfs merge=lfs -text
# (Opcional) Si tus CSV finales son MUY grandes:
# output/tables/*.csv       filter=lfs diff=lfs merge=lfs -text
docs/*.pdf filter=lfs diff=lfs merge=lfs -text
output/models/** filter=lfs diff=lfs merge=lfs -text
