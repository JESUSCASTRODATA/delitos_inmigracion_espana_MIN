# ─────────────────────────────────────────────────────────────────────────────
# SISTEMA / EDITORES
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
._*
Thumbs.db
Icon?
desktop.ini

# VSCode / JetBrains
.vscode/
.idea/
*.code-workspace

# Jupyter / Python ocasional
.ipynb_checkpoints/
__pycache__/
*.pyc

# ─────────────────────────────────────────────────────────────────────────────
# R / RStudio
# ─────────────────────────────────────────────────────────────────────────────
.Rproj.user/
.Rhistory
.RData
.Ruserdata
Rplots.pdf
*.RDataTmp

# knitr / Quarto / cache
cache/
*_cache/
*.utf8.md
*.knit.md
.quarto/
.rsconnect/

# targets / drake
_targets/
.drake/

# packrat 
packrat/

# ─────────────────────────────────────────────────────────────────────────────
# ENTORNO / SECRETS
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
.Renviron
*.key
*.pem

# ─────────────────────────────────────────────────────────────────────────────
# DEPENDENCIAS R (renv)
# ─────────────────────────────────────────────────────────────────────────────
renv/library/
renv/staging/
renv/profiles/*/library/

# ─────────────────────────────────────────────────────────────────────────────
# DATOS (evitar versionar pesados o generados)
# ─────────────────────────────────────────────────────────────────────────────
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/raw/README.md
!data/processed/README.md

# Backups / temporales de datos
*.bak
*.bak_*
*~
*.tmp
*.temp
*.old
*.orig
*.swp
*.swo

# ─────────────────────────────────────────────────────────────────────────────
# OUTPUTS (artefactos generados)
# ─────────────────────────────────────────────────────────────────────────────
# Ignora TODO lo generado por defecto…
output/**
# …excepto una allowlist mínima para el informe (ver más abajo).
# Archivos agregados a mano (zips, paquetes, etc.)
output/*.zip

# Carpeta de derivados (no publicar)
output/release/
output/manifests/
output/repro/
output/debug/
output/logs/
output/models/
output/reports/
# Si quieres mantener reports, descomenta:
# !output/reports/
# !output/reports/**

# ─────────────────────────────────────────────────────────────────────────────
# DOCUMENTOS COMPILADOS
# ─────────────────────────────────────────────────────────────────────────────
docs/*.html
docs/*.pdf
docs/*.docx

# ─────────────────────────────────────────────────────────────────────────────
# PROYECTO ESPECÍFICO 
# ─────────────────────────────────────────────────────────────────────────────
data/processed/*.bak*
data/processed/*bak_*

# ─────────────────────────────────────────────────────────────────────────────
# PERMITIDOS EXPLÍCITAMENTE (NEGACIONES) — PUBLICAR SOLO LO ESENCIAL
# ─────────────────────────────────────────────────────────────────────────────
!.gitattributes
!.gitignore
!LICENSE
!LICENSE-DOCS-CC-BY-4.0.md
!CITATION.cff
!README.md
!.github/
!.github/workflows/repro-run.yml

# Docs fuente + metadatos bibliográficos
!docs/
!docs/informe_final.Rmd
!docs/DATOS_Y_LICENCIAS.md
!docs/apa.csl
!docs/apa_fallback.csl
!docs/refs-*.bib

# Scripts (pipeline)
!scripts/
!scripts/**

