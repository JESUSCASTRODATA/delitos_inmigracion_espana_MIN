# scripts/00_theme_figuras.R
# ------------------------------------------------------------------------------
# Tema y utilidades para figuras con fondo "perla" (#FAF9F6) y paleta Okabe–Ito
# ------------------------------------------------------------------------------

# Requisitos (no instalar aquí; si faltan, parar con mensaje claro)
req <- c("ggplot2","fs")
miss <- req[!vapply(req, requireNamespace, FUN.VALUE = logical(1), quietly = TRUE)]
if (length(miss)) {
  stop(
    "Faltan paquetes: ", paste(miss, collapse = ", "),
    ". Instala con:\noptions(repos = c(CRAN='https://cloud.r-project.org'));\n",
    "install.packages(c('", paste(miss, collapse = "','"), "'))",
    call. = FALSE
  )
}

# Colores de proyecto
PEARL <- "#FAF9F6"  # fondo perla
# Paleta Okabe–Ito (colorblind-safe)
OI <- c(
  "#000000", # 1 negro
  "#E69F00", # 2 naranja
  "#56B4E9", # 3 azul claro
  "#009E73", # 4 verde
  "#F0E442", # 5 amarillo
  "#0072B2", # 6 azul
  "#D55E00", # 7 rojo
  "#CC79A7", # 8 magenta
  "#999999"  # 9 gris
)

# Utilidad: devolver n colores de OI (reciclando si hace falta)
oi <- function(n) rep_len(OI, n)

# Tema base con grid fino
theme_pearl <- function(base_size = 12, base_family = "sans") {
  ggplot2::theme_minimal(base_size = base_size, base_family = base_family) %+replace%
    ggplot2::theme(
      # Fondos
      plot.background   = ggplot2::element_rect(fill = PEARL, colour = NA),
      panel.background  = ggplot2::element_rect(fill = PEARL, colour = NA),
      
      # Grid fino (colores suaves y líneas delgadas)
      panel.grid.major  = ggplot2::element_line(colour = "#E7E5E1", linewidth = 0.4),
      panel.grid.minor  = ggplot2::element_line(colour = "#EEEDE9", linewidth = 0.25),
      
      # Texto
      axis.title        = ggplot2::element_text(face = "bold"),
      plot.title        = ggplot2::element_text(face = "bold", size = ggplot2::rel(1.2)),
      plot.subtitle     = ggplot2::element_text(colour = "#444444"),
      plot.caption      = ggplot2::element_text(colour = "#5A5A5A"),
      
      # Leyenda
      legend.background = ggplot2::element_rect(fill = PEARL, colour = NA),
      legend.key        = ggplot2::element_rect(fill = PEARL, colour = NA),
      
      # Facetas
      strip.background  = ggplot2::element_rect(fill = "#EEEDE9", colour = NA),
      strip.text        = ggplot2::element_text(face = "bold")
    )
}

# Escalas manuales Okabe–Ito listas para usar
scale_color_oi <- function(values = OI, ..., drop = FALSE) {
  ggplot2::scale_color_manual(values = values, drop = drop, ...)
}
scale_fill_oi <- function(values = OI, ..., drop = FALSE) {
  ggplot2::scale_fill_manual(values = values, drop = drop, ...)
}

# Guardado con fondo perla y aplicación automática del tema
ggsave_pearl <- function(filename,
                         plot   = ggplot2::last_plot(),
                         width  = 12,
                         height = 7,
                         dpi    = 300,
                         units  = "in",
                         ...) {
  fs::dir_create(dirname(filename))
  ggplot2::ggsave(
    filename = filename,
    plot     = plot + theme_pearl(),
    width    = width,
    height   = height,
    dpi      = dpi,
    units    = units,
    bg       = PEARL,
    ...
  )
}

# (Opcional) Set global del tema en sesiones interactivas
if (interactive()) {
  try(ggplot2::theme_set(theme_pearl()), silent = TRUE)
  message("Cargado tema 'pearl' y utilidades: PEARL, OI, theme_pearl(), ggsave_pearl(), scale_*_oi().")
}
